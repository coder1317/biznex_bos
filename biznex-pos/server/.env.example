# Biznex POS server configuration
PORT=3000
HOST=0.0.0.0

# IMPORTANT: set a long random secret in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated origins allowed through CORS (empty = allow all)
CORS_ORIGINS=

# Path to the SQLite database file
DB_PATH=./data/biznex.db

# Path to the built POS web app (defaults to ../pos-web/dist)
# PUBLIC_DIR=
