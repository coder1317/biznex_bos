[Unit]
Description=Biznex POS — in-store server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/biznex-pos/server
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
# Hardening (optional but good hygiene)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/biznex-pos/server/data

[Install]
WantedBy=multi-user.target
